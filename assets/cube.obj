# Unit cube centered at origin, 6 quad faces, per-face normals, full 0..1 uvs per face
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0  1
vn  0  0 -1
vn  1  0  0
vn -1  0  0
vn  0  1  0
vn  0 -1  0

# front (+z)
f 1/1/1 2/2/1 3/3/1 4/4/1
# back (-z)
f 6/1/2 5/2/2 8/3/2 7/4/2
# right (+x)
f 2/1/3 6/2/3 7/3/3 3/4/3
# left (-x)
f 5/1/4 1/2/4 4/3/4 8/4/4
# top (+y)
f 4/1/5 3/2/5 7/3/5 8/4/5
# bottom (-y)
f 5/1/6 6/2/6 2/3/6 1/4/6
